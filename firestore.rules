rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sem login: qualquer pessoa com o link lê e edita marcadores.
    // A validação só impede lixo (campos errados / textos gigantes).
    match /markers/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if validMarker(request.resource.data);
    }

    function validMarker(d) {
      return d.keys().hasOnly(['name', 'description', 'color', 'lat', 'lng', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.get('description', '') is string && d.get('description', '').size() <= 2000
        && d.color is string && d.color.size() <= 9
        && d.lat is number && d.lng is number;
    }
  }
}
